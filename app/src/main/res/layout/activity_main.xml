<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#F7F2FA"
     android:padding="16dp"
     android:orientation="vertical">

    <RelativeLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         android:layout_marginTop="12dp"
         android:paddingHorizontal="8dp">

        <ImageView
             android:layout_height="32dp"
             android:layout_width="32dp"
             android:src="@drawable/ic_log"
             android:layout_centerVertical="true"
             app:tint="#6750A4"
             android:id="@+id/ivAppIcon" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_toEndOf="@id/ivAppIcon"
             android:layout_centerVertical="true"
             android:textSize="20sp"
             android:textColor="#1D1B20"
             android:layout_marginStart="12dp"
             android:text="EpicV2加固-静态还原工具"
             android:textStyle="bold" />

        <ImageButton
             android:layout_height="40dp"
             android:layout_width="40dp"
             android:src="@android:drawable/ic_dialog_info"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:layout_centerVertical="true"
             app:tint="#49454F"
             android:layout_alignParentEnd="true"
             android:id="@+id/btnInfo" />

    </RelativeLayout>

    <com.google.android.material.card.MaterialCardView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         app:cardElevation="0dp"
         app:strokeWidth="0dp"
         app:cardCornerRadius="24dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="20dp"
             android:orientation="vertical">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center_vertical">

                <ImageView
                     android:layout_height="20dp"
                     android:layout_width="20dp"
                     android:src="@drawable/ic_description"
                     app:tint="#6750A4" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="18sp"
                     android:textColor="#1D1B20"
                     android:layout_marginStart="8dp"
                     android:text="选择 APK 文件"
                     android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="130dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/shape_dashed_box"
                 android:gravity="center"
                 android:clickable="true"
                 android:orientation="vertical"
                 android:layout_marginTop="16dp"
                 android:focusable="true"
                 android:id="@+id/boxSelectApk">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="36sp"
                     android:textColor="#49454F"
                     android:text="+" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:ellipsize="middle"
                     android:textSize="15sp"
                     android:singleLine="true"
                     android:textColor="#49454F"
                     android:layout_marginTop="4dp"
                     android:paddingHorizontal="16dp"
                     android:id="@+id/tvApkPathShow"
                     android:text="点击选择 APK 文件" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="14dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:background="#1F6750A4"
                     android:paddingVertical="6dp"
                     android:textSize="12sp"
                     android:textColor="#6750A4"
                     android:paddingHorizontal="14dp"
                     android:id="@+id/tvStatusBadge"
                     android:text="✔ 未选择文件"
                     android:textStyle="bold" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:background="#1F49454F"
                     android:paddingVertical="6dp"
                     android:textSize="12sp"
                     android:textColor="#49454F"
                     android:layout_marginStart="10dp"
                     android:paddingHorizontal="14dp"
                     android:id="@+id/tvPermissionBadge"
                     android:text="权限: 未检查"
                     android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                     android:layout_height="52dp"
                     android:layout_width="0dp"
                     app:icon="@android:drawable/ic_menu_search"
                     android:layout_marginEnd="8dp"
                     app:cornerRadius="26dp"
                     style="@style/Widget.Material3.Button.TonalButton"
                     android:layout_weight="1"
                     android:id="@+id/btnSelectFile"
                     android:text="选择文件" />

                <com.google.android.material.button.MaterialButton
                     android:layout_height="52dp"
                     android:layout_width="0dp"
                     app:icon="@android:drawable/ic_media_play"
                     app:cornerRadius="26dp"
                     android:backgroundTint="#6750A4"
                     android:layout_weight="1"
                     android:id="@+id/btnStart"
                     android:text="开始脱壳" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 app:icon="@android:drawable/ic_lock_lock"
                 app:cornerRadius="26dp"
                 style="@style/Widget.Material3.Button.OutlinedButton"
                 android:layout_marginTop="8dp"
                 android:id="@+id/btnReqPerm"
                 android:text="申请权限" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
         android:layout_height="0dp"
         android:layout_width="match_parent"
         app:cardElevation="0dp"
         app:strokeWidth="0dp"
         app:cardCornerRadius="24dp"
         android:layout_weight="1">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:padding="20dp"
             android:orientation="vertical">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center_vertical">

                <ImageView
                     android:layout_height="20dp"
                     android:layout_width="20dp"
                     android:src="@drawable/ic_log"
                     app:tint="#6750A4" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="18sp"
                     android:textColor="#1D1B20"
                     android:layout_marginStart="8dp"
                     android:text="运行日志"
                     android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:layout_marginTop="12dp"
                 android:id="@+id/progressIndicator" />

            <ScrollView
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:background="@drawable/shape_log_bg"
                 android:padding="12dp"
                 android:layout_marginTop="12dp"
                 android:id="@+id/scrollLog">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="12sp"
                     android:textColor="#49454F"
                     android:lineSpacingExtra="4dp"
                     android:id="@+id/tvLog"
                     android:text="等待开始..." />

            </ScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>